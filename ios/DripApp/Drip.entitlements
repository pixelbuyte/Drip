<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (guideline 4.8: required alongside Google sign-in). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Apple Pay through Stripe. The App ID must have this merchant ID. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>$(DRIP_APPLE_MERCHANT_ID)</string>
	</array>
	<!-- Universal links: https://<domain>/v/<videoId> opens the app at that
	     video. The site serves /.well-known/apple-app-site-association once
	     APPLE_TEAM_ID is set on the deployment. The App ID must have the
	     Associated Domains capability. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(DRIP_ASSOCIATED_DOMAIN)</string>
	</array>
</dict>
</plist>
