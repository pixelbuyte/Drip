# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---------------------------------------------------------------
# Local dev: http://localhost:3000 . Production: your real https:// domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses RLS — server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers -> API keys) -----------------------------------
STRIPE_SECRET_KEY=sk_test_
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# In production, copy it from the webhook endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_

# --- Mux (Settings -> Access Tokens; needs Video + Data read) ----------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux dashboard -> Settings -> Webhooks -> signing secret.
MUX_WEBHOOK_SECRET=

# --- EasyPost (API Keys; use the TEST key until launch) ----------------
EASYPOST_API_KEY=
# EasyPost dashboard -> Webhooks -> the secret used for HMAC verification.
EASYPOST_WEBHOOK_SECRET=

# --- Resend (API Keys) -------------------------------------------------
RESEND_API_KEY=re_
# Must be on a domain verified in Resend before you can email real buyers.
RESEND_FROM_EMAIL=Drip <orders@yourdomain.com>

# --- Feed identity ----------------------------------------------------
# Signs the anon device cookie (drip_aid) so a client cannot fabricate or
# borrow viewer identities. Minimum 32 chars. Rotating it invalidates every
# existing device id, which resets affinity profiles — treat as durable.
#   openssl rand -base64 48
ANON_ID_SECRET=

# Guards the rollup/cron routes from public invocation.
CRON_SECRET=
